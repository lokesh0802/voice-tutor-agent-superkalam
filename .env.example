# --- Required ---
OPENAI_API_KEY=-
SARVAM_API_KEY=   # https://dashboard.sarvam.ai  (free credits on signup)

# --- Optional tuning ---
OPENAI_MODEL=gpt-4.1-mini     # or gpt-4o-mini (cheaper)
OPENAI_EMBED_MODEL=text-embedding-3-small
SARVAM_VOICE=priya            # bulbul:v3 voices: priya, neha, ritu, kavya, simran, rahul, aditya, rohan, shubh ...
SARVAM_PACE=1.0               # 0.5 - 2.0

# --- Twilio (only for phone calls; lets the bot hang up the call itself) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# cp .env.example .env              # add OPENAI_API_KEY + SARVAM_API_KEY
